{
  "name": "postpaid-bill-summary-manager",
  "version": "1.0.0",
  "description": "Native Windows desktop application that automates postpaid telephone bill PDF processing, Account Summary extraction, employee-wise consolidation, deduction tracking and Bill Summary reporting. 100% offline and local.",
  "main": "./out/main/index.js",
  "author": "IT Department",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:resources": "node scripts/build-pdfjs-worker.mjs && node scripts/fetch-tessdata.mjs",
    "build": "npm run typecheck && npm run build:resources && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "package:win": "npm run build && node scripts/prepare-win-natives.mjs && electron-builder --win",
    "package:win:portable": "npm run build && electron-builder --win portable",
    "samples": "node scripts/make-sample-pdfs.mjs",
    "test:bundle": "node scripts/test-bundle.mjs",
    "pretest": "npm rebuild better-sqlite3 --silent",
    "test:node": "vitest run",
    "rebuild:electron": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.100",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^11.3.0",
    "exceljs": "^4.4.0",
    "papaparse": "^5.4.1",
    "pdfjs-dist": "^4.6.82",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.14.0",
    "@types/papaparse": "^5.3.14",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "lucide-react": "^0.454.0",
    "pdf-lib": "^1.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.2",
    "vite": "^5.4.6",
    "vitest": "^2.1.1"
  }
}
